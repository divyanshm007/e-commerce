# Copy to .env.production on the server (chmod 600). NEVER commit the real file.
# Compose reads it for ${...} substitution (--env-file) and the api container reads it as env_file.

RELEASE=2026-11-xx                      # image tag for this release (api + web)
DB_PASSWORD=<new strong password>       # rotate from the UAT password at cutover (ALTER USER postgres ...)

# --- JWT (use a NEW random 64+ character secret; existing sessions are signed out at cutover)
Jwt__Key=<random>
Jwt__Issuer=EcommerceApp
Jwt__Audience=EcommerceApp
Jwt__ExpiryHours=24

# --- e-mail (taken from the old production environment: EMAIL_USER / EMAIL_PASS / ADMIN_EMAIL)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=<store mailbox>
Email__Password=<gmail app password>
Email__FromName=Sidham Pharmacy
Email__AdminEmail=<store owner inbox>

# --- Razorpay: LIVE keys from the old production environment (API_KEY / SECRET_KEY). Test keys stay unset.
Razorpay__Live__KeyId=<rzp_live_...>
Razorpay__Live__KeySecret=<secret>
Razorpay__WebhookSecret=<webhook secret configured in the Razorpay dashboard>

# --- Delhivery (needed by the shipping module once it exists; copied from the old DELHIVERY_* values)
Delhivery__ApiKey=<key>
Delhivery__BaseUrl=https://track.delhivery.com
Delhivery__WarehouseName=Ganpati Herbal Ayurveda

# --- first super admin ONLY if the database has none (it already has two) - leave unset
# SeedAdmin__Email=
# SeedAdmin__Password=

RateLimit__LoginPerMinute=20
RateLimit__PasswordResetPerMinute=10
